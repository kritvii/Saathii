PORT=3004

# Pick ONE:
# Local MongoDB (macOS: brew services start mongodb-community)
MONGODB_URI=mongodb://127.0.0.1:27017/saathi
# MongoDB Atlas (replace user, password and cluster; keep /saathi before the ?)
# MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/saathi?retryWrites=true&w=majority

# Long random string, e.g. output of: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret

# Insert the 12 sample opportunities on start (set to false for a clean production DB)
SEED_SAMPLE_DATA=true
